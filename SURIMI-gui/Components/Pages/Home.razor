@page "/"
@using SURIMI_gui.Services
@using SURIMI_gui.Components.Shared
@implements IDisposable

<PageTitle>Home</PageTitle>

<div class="row mt-3">

    <h1>SURIMI</h1>

    <p>
        This is a SURIMI Test webapp
    </p>

    <p>
        <a href="https://www.surimi-project.eu/">SURIMI</a>
    </p>

    <h2>Initialize the simulation</h2>

    @if (config == null || scenarioNames == null || climateScenarios == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <EditForm Model="config" OnSubmit="HandleSubmit">
            <ValidationSummary />
            <div class="form-group row">
                <label class="col-md-2 col-form-label">Scenario Name</label>
                <div class="col-md-2">
                    <select class="form-select" value="@config.ScenarioName" @onchange="OnScenarioNameChanged" disabled="@isSubmitLoading">
                        @foreach (var name in scenarioNames)
                        {
                            <option value="@name">@name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-group row">
                <label class="col-md-2 col-form-label">Climate Scenario</label>
                <div class="col-md-2">
                    <select class="form-select" @bind="config.ClimateScenario">
                        @foreach (var scenario in climateScenarios)
                        {
                            <option value="@scenario">@scenario</option>
                        }
                        <option value=""></option>
                    </select>
                </div>
            </div>
            <div class="form-group row">
                <label class="col-md-2 col-form-label">MSE Run</label>
                <div class="col-md-2">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" @bind="config.IsMseRun"
                               title="Select whether this is an MSE run">
                    </div>
                </div>
            </div>
            <div class="form-group row">
                <label class="col-md-2 col-form-label">End Date (optional)</label>
                <div class="col-md-2">
                    <input type="date" class="form-control" @bind="config.EndDateTime"
                           title="Optional. Select the end date for the simulation">
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 my-3">
                <button type="button" class="btn btn-outline-primary" style="width: 155px"
                        disabled="@(isSubmitLoading || isScenarioDataLoading || !scenarioDataLoaded)"
                        @onclick="OpenHcrDialogAsync">Add HCR</button>
                <span aria-live="polite">@config.HarvestControlRules.Count(rule => rule.Selected) hcr's added</span>
            </div>
            @if (isScenarioDataLoading)
            {
                <p><em>Loading harvest control rules...</em></p>
            }
            else if (!scenarioDataLoaded && !string.IsNullOrWhiteSpace(config.ScenarioName))
            {
                <button type="button" class="btn btn-outline-secondary mb-3" @onclick="LoadScenarioDataAsync" disabled="@isSubmitLoading">Retry loading scenario data</button>
            }

            <div class="d-grid gap-2 mb-3">
                <div class="d-flex align-items-center">
                    <button type="submit"
                            class="btn btn-primary"
                            style="width: 155px"
                            disabled="@(isSubmitLoading || isScenarioDataLoading || !scenarioDataLoaded)">
                        Submit
                    </button>
                    @if (isSubmitLoading)
                    {
                        <span class="spinner-border spinner-border-sm text-primary ms-2" role="status" aria-hidden="true"></span>
                    }
                </div>
            </div>
            <div>
                Response: @result
            </div>
            @if (scenarioDataLoaded)
            {
                <dialog @ref="hcrDialog" class="hcr-dialog" aria-labelledby="hcr-dialog-title">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 id="hcr-dialog-title" class="mb-0">Default Harvest Control Rules</h3>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseHcrDialogAsync"></button>
                    </div>
                    <HarvestControlRuleGrid Rules="config.HarvestControlRules" SelectionChanged="StateHasChanged" />
                    <div class="d-flex justify-content-end mt-3">
                        <button type="button" class="btn btn-primary" @onclick="CloseHcrDialogAsync">Done</button>
                    </div>
                </dialog>
            }
        </EditForm>
    }
</div>

<h3 class="mt-4">Simulations</h3>
@if (simulations == null)
{
    <p><em>Loading simulations...</em></p>
}
else if (simulations.Count == 0)
{
    <p><em>No simulations found.</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Simulation Id</th>
                <th>Experiment Id</th>
                <th>Scen Id</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Status</th>
                <th>Sim Started</th>
                <th>Sim Duration</th>
                <th>Sim Current</th>
                <th>EwE IP</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sim in simulations)
            {
                <tr>
                    <td>@sim.SimulationId.Split('-')[0]</td>
                    <td>@sim.ExperimentId.Split('-')[0]</td>
                    <td>@sim.ScenarioName</td>
                    <td>@sim.StartDateTime.ToLocalTime().ToString("dd-MM-yyyy")</td>
                    <td>@sim.EndDateTime.ToLocalTime().ToString("dd-MM-yyyy")</td>
                    <td>@sim.Status</td>
                    <td>
                        @(sim.SimulationStarted.HasValue
                                        ? sim.SimulationStarted.Value.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
                                        : "")
                    </td>
                    <td>
                        @(sim.SimulationDuration.HasValue
                                        ? sim.SimulationDuration.Value.ToString(@"hh\:mm\:ss")
                                        : "")
                    </td>
                    <td>@sim.SimulationCurrent?.ToLocalTime().ToString("dd-MM-yyyy")</td>
                    <td>@sim.IP</td>
                    <td>
                        <a href="#"
                           class="btn btn-link btn-sm text-danger @(sim.Status != "Running" ? "disabled" : "")"
                           @onclick="() => CancelSimulationFor(sim)">
                            Cancel
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}




@code {
    private bool isSubmitLoading = false;
    private bool isScenarioDataLoading;
    private bool scenarioDataLoaded;
    private int scenarioLoadVersion;
    private ElementReference hcrDialog;
    private SURIMI_gui.Models.ExperimentConfig? config { get; set; }
    private List<SURIMI_gui.Models.SimulationStatus>? simulations { get; set; } = new List<SURIMI_gui.Models.SimulationStatus>();
    private List<string>? scenarioNames;
    private List<string>? climateScenarios;
    private List<string> experimentIds = new List<string>();
    private string result = "";
    CancellationTokenSource cts = new CancellationTokenSource();
    private System.Threading.Timer? _refreshTimer;

    [Inject]
    private SurimiGUIService? controllerService { get; set; }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private async Task OpenHcrDialogAsync() => await JS.InvokeVoidAsync("surimiHcrDialog.show", hcrDialog);
    private async Task CloseHcrDialogAsync() => await JS.InvokeVoidAsync("surimiHcrDialog.close", hcrDialog);

    protected override async Task OnInitializedAsync()
    {
        config = new SURIMI_gui.Models.ExperimentConfig();
        if (controllerService != null)
        {
            try
            {
                scenarioNames = (await controllerService.GetScenarioNamesAsync(cts.Token)).OrderByDescending(n => n, StringComparer.OrdinalIgnoreCase).ToList();
                config.ScenarioName = scenarioNames.FirstOrDefault();
                await LoadScenarioDataAsync();
            }
            catch (Exception ex)
            {
                result = $"Exception loading scenarios: {ex.Message}";
                scenarioNames ??= new List<string>();
                climateScenarios ??= new List<string>();
            }
        }
        StartRefreshTimer();
    }

    private async Task LoadScenarioDataAsync()
    {
        if (controllerService == null || config == null)
        {
            return;
        }

        var version = ++scenarioLoadVersion;
        var scenarioName = config.ScenarioName;
        isScenarioDataLoading = true;
        scenarioDataLoaded = false;
        climateScenarios = [];
        config.ClimateScenario = null;
        config.HarvestControlRules = [];
        result = "";

        try
        {
            if (string.IsNullOrWhiteSpace(scenarioName))
            {
                throw new InvalidOperationException("No scenario is available.");
            }

            var climateTask = controllerService.GetClimateScenariosAsync(scenarioName, cts.Token);
            var hcrTask = controllerService.GetInitialHCRDataAsync(scenarioName, cts.Token);
            await Task.WhenAll(climateTask, hcrTask);
            if (version != scenarioLoadVersion) return;

            climateScenarios = await climateTask;
            config.ClimateScenario = climateScenarios.FirstOrDefault();
            config.HarvestControlRules = await hcrTask;
            scenarioDataLoaded = true;
        }
        catch (Exception ex)
        {
            if (version == scenarioLoadVersion)
            {
                result = $"Exception loading scenario data: {ex.Message}";
            }
        }
        finally
        {
            if (version == scenarioLoadVersion) isScenarioDataLoading = false;
        }
    }

    private async Task OnScenarioNameChanged(ChangeEventArgs e)
    {
        if (config == null) return;
        config.ScenarioName = e.Value?.ToString();
        await LoadScenarioDataAsync();
    }

    private async Task HandleSubmit(EditContext editContext)
    {
        if (config != null && controllerService != null && scenarioDataLoaded && !isScenarioDataLoading && !isSubmitLoading && editContext.Validate())
        {
            isSubmitLoading = true;
            StateHasChanged();
            try
            {
                result = "";
                config.ExperimentId = Guid.NewGuid().ToString();
                var res = await controllerService.Submit(config, cts.Token);
                if (Guid.TryParse(res, out Guid simres))
                {
                    experimentIds.Add(config.ExperimentId);
                    config = new SURIMI_gui.Models.ExperimentConfig();    // Reset form
                    config.ScenarioName = scenarioNames?.FirstOrDefault();
                    await LoadScenarioDataAsync();
                    // Fetch updated simulations list after successful submit
                    simulations = await controllerService.GetSimulationsAsync(experimentIds, cts.Token);
                    if (scenarioDataLoaded) result = "OK";
                }
                else
                {
                    result = $"Error submitting simulation: {res}";
                }
            }
            catch (Exception ex)
            {
                result = $"Exception: {ex.Message}";
            }
            finally
            {
                isSubmitLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task CancelSimulationFor(SURIMI_gui.Models.SimulationStatus sim)
    {
        if (controllerService != null)
        {
            result = "";
            result = await controllerService.RemoveExperimentAsync(sim.ExperimentId, CancellationToken.None);
            // Optionally refresh simulations list
            simulations = await controllerService.GetSimulationsAsync(experimentIds, CancellationToken.None);

            StateHasChanged();
        }
    }

    private void StartRefreshTimer()
    {
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            await RefreshSimulations();
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(2));
    }

    private async Task RefreshSimulations()
    {
        if (controllerService != null)
        {
            try
            {
                var sims = await controllerService.GetSimulationsAsync(experimentIds, CancellationToken.None);
                await InvokeAsync(() =>
                {
                    simulations = sims;
                    StateHasChanged();
                });
            }
            catch
            {
                // Optionally handle errors
            }
        }
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}