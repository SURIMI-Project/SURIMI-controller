@page "/"
@using SURIMI_gui.Services
@using System.Diagnostics
@implements IDisposable

<PageTitle>Home</PageTitle>

<div class="row mt-3">

    <!-- LEFT COLUMN: Your existing content -->
    <div class="col-8">
        <h1>SURIMI</h1>

        <p>
            This is a SURIMI Test webapp
        </p>

        <p>
            <a href="https://www.surimi-project.eu/">SURIMI</a>
        </p>

        <h2>Initialize the simulation</h2>

        @if (config == null)
        {
                    <p><em>Loading...</em></p>
        }
        else
        {
            <EditForm Model="config" OnSubmit="HandleInit">
                <div class="form-group row">
                    <label class="col-md-2 col-form-label">Scenario Id</label>
                    <div class="col-md-2">
                        <input type="text" class="form-control" @bind="config.ScenarioId">
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-md-2 col-form-label">Number of runs</label>
                    <div class="col-md-2">
                        <input type="number" class="form-control" @bind="config.NumberOfRuns"
                               title="Select the number of runs for the simulation">
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-md-2 col-form-label">End Date (optional)</label>
                    <div class="col-md-2">
                        <input type="date" class="form-control" @bind="config.EndDateTime"
                               title="Optional. Select the end date for the simulation">
                    </div>
                </div>

                <div class="d-grid gap-2 mb-3">
                    <div class="d-flex align-items-center">
                        <button type="submit"
                                class="btn btn-primary"
                                style="width: 155px"
                                disabled="@isInitLoading">
                            Submit
                        </button>
                        @if (isInitLoading)
                        {
                            <span class="spinner-border spinner-border-sm text-primary ms-2" role="status" aria-hidden="true"></span>
                        }
                    </div>
                </div>
                <div class="col-7">
                    Response: @result
                </div>
            </EditForm>
        }
    </div>
    <div class="col-4">
            <EditoAppList Apps="@editoApps"
                          Loading="@editoAppsLoading"
                          Error="@editoAppsError" />
    </div>
</div>

<h3 class="mt-4">Simulations</h3>
@if (simulations == null)
{
    <p><em>Loading simulations...</em></p>
}
else if (simulations.Count == 0)
{
    <p><em>No simulations found.</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Simulation Id</th>
                <th>Experiment Id</th>
                <th>Scen Id</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Status</th>
                <th>Sim Started</th>
                <th>Sim Duration</th>
                <th>Sim Current</th>
                <th>EwE IP</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sim in simulations)
            {
                <tr>
                    <td>@sim.SimulationId.Split('-')[0]</td>
                    <td>@sim.ExperimentId.Split('-')[0]</td>
                    <td>@sim.ScenarioId</td>
                    <td>@sim.StartDateTime.ToLocalTime().ToString("dd-MM-yyyy")</td>
                    <td>@sim.EndDateTime.ToLocalTime().ToString("dd-MM-yyyy")</td>
                    <td>@sim.Status</td>
                    <td>
                        @(sim.SimulationStarted.HasValue
                                        ? sim.SimulationStarted.Value.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
                                        : "")
                                            </td>
                                            <td>
                        @(sim.SimulationDuration.HasValue
                                        ? sim.SimulationDuration.Value.ToString(@"hh\:mm\:ss")
                                        : "")
        </td>
        <td>@sim.SimulationCurrent?.ToLocalTime().ToString("dd-MM-yyyy")</td>
        <td>@sim.IP</td>
        <td>
            <a href="#"
                class="btn btn-link btn-sm text-danger @(sim.Status != "Running" ? "disabled" : "")"
                @onclick="() => CancelSimulationFor(sim)">
                Cancel
            </a>
        </td>
    </tr>
            }
        </tbody>
    </table>
}




@code {
    private bool isInitLoading = false;
    private SURIMI_gui.Models.ExperimentConfig? config { get; set; }
    private List<SURIMI_gui.Models.SimulationStatus>? simulations { get; set; } = new List<SURIMI_gui.Models.SimulationStatus>();
    private string result = "";
    CancellationTokenSource cts = new CancellationTokenSource();
    private System.Threading.Timer? _refreshTimer;

    // EDITO DataLab properties
    private List<SURIMI_gui.Models.App>? editoApps { get; set; }
    private bool editoAppsLoading = true;
    private string editoAppsError = string.Empty;


    [Inject]
    private SurimiGUIControllerService? controllerService { get; set; }

    [Inject]
    private EditoDataLabService? editoDataLabService { get; set; }

    protected override async Task OnInitializedAsync()
    {
        config = new SURIMI_gui.Models.ExperimentConfig();
        config.EndDateTime = new DateTime(2017, 01, 01);    // not all the way to 2050
        StartRefreshTimer();

        // Load EDITO DataLab services
        await LoadEditoDataLabServices();
    }

    private async Task LoadEditoDataLabServices()
    {
        if (editoDataLabService != null)
        {
            try
            {
                editoAppsLoading = true;
                editoAppsError = string.Empty;   // <-- CLEAR ERROR HERE
                editoApps = await editoDataLabService.GetMyLabServicesAsync(cts.Token);
            }
            catch (Exception ex)
            {
                editoAppsError = ex.Message;
            }
            finally
            {
                editoAppsLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task HandleInit()
    {
        if (config != null && controllerService != null)
        {
            isInitLoading = true;
            StateHasChanged();
            try
            {
                result = "";
                config.ExperimentId = Guid.NewGuid().ToString();
                var res = await controllerService.Init(config, cts.Token);
                if (Guid.TryParse(res, out Guid simres))
                {
                    config = new SURIMI_gui.Models.ExperimentConfig();    // Reset form
                    // Fetch updated simulations list after successful init
                    simulations = await controllerService.GetAllSimulationsAsync(cts.Token);
                    result = $"OK";
                }
                else
                {
                    result = $"Error initializing simulation: {res}";
                }
            }
            catch (Exception ex)
            {
                result = $"Exception: {ex.Message}";
            }
            finally
            {
                isInitLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task CancelSimulationFor(SURIMI_gui.Models.SimulationStatus sim)
    {
        if (controllerService != null)
        {
            result = "";
            result = await controllerService.CancelExperimentAsync(sim.ExperimentId, CancellationToken.None);
            // Optionally refresh simulations list
            simulations = await controllerService.GetAllSimulationsAsync(CancellationToken.None);

            StateHasChanged();
        }
    }

    private void StartRefreshTimer()
    {
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            await RefreshSimulations();
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(2));
    }

    private async Task RefreshSimulations()
    {
        if (controllerService != null)
        {
            try
            {
                var sims = await controllerService.GetAllSimulationsAsync(CancellationToken.None);
                await InvokeAsync(() =>
                {
                    simulations = sims;
                    StateHasChanged();
                });
            }
            catch
            {
                // Optionally handle errors
            }
        }
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}