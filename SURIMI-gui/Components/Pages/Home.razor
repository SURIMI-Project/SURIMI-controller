@page "/"
@using SURIMI_gui.Services
@using System.Diagnostics
@implements IDisposable

<PageTitle>Home</PageTitle>

<div class="row mt-3">

    <h1>SURIMI</h1>

    <p>
        This is a SURIMI Test webapp
    </p>

    <p>
        <a href="https://www.surimi-project.eu/">SURIMI</a>
    </p>

    <h2>Initialize the simulation</h2>

    @if (config == null || scenarioNames == null || climateScenarios == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <EditForm Model="config" OnSubmit="HandleSubmit">
            <div class="form-group row">
                <label class="col-md-2 col-form-label">Scenario Name</label>
                <div class="col-md-2">
                    <select class="form-select" value="@config.ScenarioName" @onchange="OnScenarioNameChanged">
                        @foreach (var name in scenarioNames)
                        {
                            <option value="@name">@name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-group row">
                <label class="col-md-2 col-form-label">Climate Scenario</label>
                <div class="col-md-2">
                    <select class="form-select" @bind="config.ClimateScenario">
                        @foreach (var scenario in climateScenarios)
                        {
                            <option value="@scenario">@scenario</option>
                        }
                        <option value=""></option>
                    </select>
                </div>
            </div>
            <div class="form-group row">
                <label class="col-md-2 col-form-label">MSE Run</label>
                <div class="col-md-2">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" @bind="config.IsMseRun"
                               title="Select whether this is an MSE run">
                    </div>
                </div>
            </div>
            <div class="form-group row">
                <label class="col-md-2 col-form-label">End Date (optional)</label>
                <div class="col-md-2">
                    <input type="date" class="form-control" @bind="config.EndDateTime"
                           title="Optional. Select the end date for the simulation">
                </div>
            </div>

            <div class="d-grid gap-2 mb-3">
                <div class="d-flex align-items-center">
                    <button type="submit"
                            class="btn btn-primary"
                            style="width: 155px"
                            disabled="@isSubmitLoading">
                        Submit
                    </button>
                    @if (isSubmitLoading)
                    {
                        <span class="spinner-border spinner-border-sm text-primary ms-2" role="status" aria-hidden="true"></span>
                    }
                </div>
            </div>
            <div class="col-7">
                Response: @result
            </div>
        </EditForm>
    }
</div>

<h3 class="mt-4">Simulations</h3>
@if (simulations == null)
{
    <p><em>Loading simulations...</em></p>
}
else if (simulations.Count == 0)
{
    <p><em>No simulations found.</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Simulation Id</th>
                <th>Experiment Id</th>
                <th>Scen Id</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Status</th>
                <th>Sim Started</th>
                <th>Sim Duration</th>
                <th>Sim Current</th>
                <th>EwE IP</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sim in simulations)
            {
                <tr>
                    <td>@sim.SimulationId.Split('-')[0]</td>
                    <td>@sim.ExperimentId.Split('-')[0]</td>
                    <td>@sim.ScenarioName</td>
                    <td>@sim.StartDateTime.ToLocalTime().ToString("dd-MM-yyyy")</td>
                    <td>@sim.EndDateTime.ToLocalTime().ToString("dd-MM-yyyy")</td>
                    <td>@sim.Status</td>
                    <td>
                        @(sim.SimulationStarted.HasValue
                                        ? sim.SimulationStarted.Value.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
                                        : "")
                    </td>
                    <td>
                        @(sim.SimulationDuration.HasValue
                                        ? sim.SimulationDuration.Value.ToString(@"hh\:mm\:ss")
                                        : "")
                    </td>
                    <td>@sim.SimulationCurrent?.ToLocalTime().ToString("dd-MM-yyyy")</td>
                    <td>@sim.IP</td>
                    <td>
                        <a href="#"
                           class="btn btn-link btn-sm text-danger @(sim.Status != "Running" ? "disabled" : "")"
                           @onclick="() => CancelSimulationFor(sim)">
                            Cancel
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}




@code {
    private bool isSubmitLoading = false;
    private SURIMI_gui.Models.ExperimentConfig? config { get; set; }
    private List<SURIMI_gui.Models.SimulationStatus>? simulations { get; set; } = new List<SURIMI_gui.Models.SimulationStatus>();
    private List<string>? scenarioNames;
    private List<string>? climateScenarios;
    private string result = "";
    CancellationTokenSource cts = new CancellationTokenSource();
    private System.Threading.Timer? _refreshTimer;

    [Inject]
    private SurimiGUIService? controllerService { get; set; }

    protected override async Task OnInitializedAsync()
    {
        config = new SURIMI_gui.Models.ExperimentConfig();
        if (controllerService != null)
        {
            try
            {
                scenarioNames = (await controllerService.GetScenarioNamesAsync(cts.Token)).OrderByDescending(n => n, StringComparer.OrdinalIgnoreCase).ToList();
                config.ScenarioName = scenarioNames.FirstOrDefault() ?? config.ScenarioName;
                await LoadClimateScenariosAsync();
            }
            catch (Exception ex)
            {
                result = $"Exception loading scenarios: {ex.Message}";
                scenarioNames ??= new List<string>();
                climateScenarios ??= new List<string>();
            }
        }
        StartRefreshTimer();
    }

    private async Task LoadClimateScenariosAsync()
    {
        if (controllerService == null || config == null)
        {
            return;
        }

        climateScenarios = await controllerService.GetClimateScenariosAsync(config.ScenarioName ?? "", cts.Token);
        config.ClimateScenario = climateScenarios.FirstOrDefault();
    }

    private async Task OnScenarioNameChanged(ChangeEventArgs e)
    {
        if (config == null)
        {
            return;
        }

        config.ScenarioName = e.Value?.ToString();
        try
        {
            await LoadClimateScenariosAsync();
        }
        catch (Exception ex)
        {
            result = $"Exception loading climate scenarios: {ex.Message}";
            climateScenarios = new List<string>();
        }
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        if (config != null && controllerService != null)
        {
            isSubmitLoading = true;
            StateHasChanged();
            try
            {
                result = "";
                config.ExperimentId = Guid.NewGuid().ToString();
                var res = await controllerService.Submit(config, cts.Token);
                if (Guid.TryParse(res, out Guid simres))
                {
                    config = new SURIMI_gui.Models.ExperimentConfig();    // Reset form
                    config.ScenarioName = scenarioNames?.FirstOrDefault() ?? config.ScenarioName;
                    await LoadClimateScenariosAsync();
                    // Fetch updated simulations list after successful submit
                    simulations = await controllerService.GetAllSimulationsAsync(cts.Token);
                    result = $"OK";
                }
                else
                {
                    result = $"Error submitting simulation: {res}";
                }
            }
            catch (Exception ex)
            {
                result = $"Exception: {ex.Message}";
            }
            finally
            {
                isSubmitLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task CancelSimulationFor(SURIMI_gui.Models.SimulationStatus sim)
    {
        if (controllerService != null)
        {
            result = "";
            result = await controllerService.RemoveExperimentAsync(sim.ExperimentId, CancellationToken.None);
            // Optionally refresh simulations list
            simulations = await controllerService.GetAllSimulationsAsync(CancellationToken.None);

            StateHasChanged();
        }
    }

    private void StartRefreshTimer()
    {
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            await RefreshSimulations();
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(2));
    }

    private async Task RefreshSimulations()
    {
        if (controllerService != null)
        {
            try
            {
                var sims = await controllerService.GetAllSimulationsAsync(CancellationToken.None);
                await InvokeAsync(() =>
                {
                    simulations = sims;
                    StateHasChanged();
                });
            }
            catch
            {
                // Optionally handle errors
            }
        }
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}