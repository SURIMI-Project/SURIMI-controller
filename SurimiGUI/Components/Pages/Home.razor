@page "/"
@using SurimiGUI.Models
@using SurimiGUI.Services
@using System.Diagnostics
@inject ActivitySource MyActivitySource

<PageTitle>Home</PageTitle>

<h1>SURIMI</h1>

<p>
    This is a SURIMI Test webapp
</p>

<p>
    <a href="https://www.surimi-project.eu/">SURIMI</a>
</p>

<h2>Initialize the simulation</h2>

@if (config == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="config" OnSubmit="HandleInit">
        <div class="form-group row">
            <label class="col-md-2 col-form-label">Scenario Id</label>
            <div class="col-md-6">
                <input type="text" class="form-control" @bind="config.ScenarioId">
            </div>
        </div>
        <div class="form-group row">
            <label class="col-md-2 col-form-label">Start Date</label>
            <div class="col-md-6">
                <input type="date" class="form-control" @bind="config.StartDateTime" />
            </div>
        </div>
        <div class="form-group row">
            <label class="col-md-2 col-form-label">Step size</label>
            <div class="col-md-6">
                <input type="text" class="form-control" @bind="config.StepSize">
            </div>
        </div>
        <div class="form-group row">
            <label class="col-md-2 col-form-label">Simulation duration</label>
            <div class="col-md-6">
                <input type="text" class="form-control" @bind="config.SimulationDuration">
            </div>
        </div>
        <div class="form-group row">
            <label class="col-md-2 col-form-label">Simulation Id</label>
            <div class="col-md-6">
                <input type="text" class="form-control" @bind="config.SimulationId" readonly="true">
            </div>
        </div>

        <div class="d-grid gap-2 mb-3">
            <div class="d-flex align-items-center">
                <button type="submit"
                        class="btn btn-primary"
                        style="width: 155px"
                        disabled="@isInitLoading">
                    Init
                </button>
                @if (isInitLoading)
                {
                    <span class="spinner-border spinner-border-sm text-primary ms-2" role="status" aria-hidden="true"></span>
                }
            </div>
            <div class="d-flex align-items-center">
                <button type="button"
                        class="btn btn-secondary"
                        style="width: 155px"
                        disabled="@isStartLoading"
                        @onclick="HandleStartSimulation">
                    Start Simulation
                </button>
                @if (isStartLoading)
                {
                    <span class="spinner-border spinner-border-sm text-secondary ms-2" role="status" aria-hidden="true"></span>
                }
            </div>
            <div class="d-flex align-items-center">
                <button type="button"
                        class="btn btn-danger"
                        style="width: 155px"
                        disabled="@(!isStartLoading)"
                        @onclick="HandleCancelSimulation">
                    Cancel Simulation
                </button>
            </div>
        </div>
        <div class="col-7">
            Response: @result
        </div>
    </EditForm>
}

@code {
    private bool isInitLoading = false;
    private bool isStartLoading = false;
    private SimulationConfig? config { get; set; }
    private string result = "";
    CancellationTokenSource cts = new CancellationTokenSource();

    [Inject]
    private SurimiGUIControllerService? controllerService { get; set; }

    protected override void OnInitialized()
    {
        config = new SimulationConfig();
    }

    async Task HandleInit()
    {
        if (config != null && controllerService != null)
        {
            isInitLoading = true;
            StateHasChanged();
            try
            {
                using (var activity = MyActivitySource.StartActivity("HandleInit"))
                {
                    activity?.SetTag("ScenarioId", config.ScenarioId);
                    result = "";
                    config.SimulationId = "";
                    var res = await controllerService.Init(config, cts.Token);
                    if (Guid.TryParse(res, out Guid simres))
                    {
                        config.SimulationId = res;
                        result = $"OK";
                    }
                    else
                    {
                        result = $"Error initializing simulation: {res}";
                    }
                }
            }
            catch (Exception ex)
            {
                result = ex.Message;
            }
            finally
            {
                isInitLoading = false;
                StateHasChanged();
            }
        }
    }


    async Task HandleStartSimulation()
    {
        if (config != null && controllerService != null)
        {
            isStartLoading = true;
            StateHasChanged();

            try
            {
                using (var activity = MyActivitySource.StartActivity("HandleStartSimulation"))
                {
                    activity?.SetTag("SimulationId", config.SimulationId);
                    cts = new CancellationTokenSource();
                    result = "";
                    result = await controllerService.RunSimulation(config, cts.Token);
                }
            }
            catch (Exception ex)
            {
                result = ex.Message;
            }
            finally
            {
                isStartLoading = false;
                StateHasChanged();
            }
        }
    }

    void HandleCancelSimulation()
    {
        using (var activity = MyActivitySource.StartActivity("HandleCancelSimulation"))
        {
            cts.Cancel();
        }
    }
}