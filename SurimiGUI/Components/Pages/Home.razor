@page "/"
@using SurimiGUI.Models
@using SurimiGUI.Services
@using System.Diagnostics
@inject ActivitySource MyActivitySource
@implements IDisposable

<PageTitle>Home</PageTitle>

<h1>SURIMI</h1>

<p>
    This is a SURIMI Test webapp
</p>

<p>
    <a href="https://www.surimi-project.eu/">SURIMI</a>
</p>

<h2>Initialize the simulation</h2>

@if (config == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="config" OnSubmit="HandleInit">
        <div class="form-group row">
            <label class="col-md-2 col-form-label">Scenario Id</label>
            <div class="col-md-6">
                <input type="text" class="form-control" @bind="config.ScenarioId">
            </div>
        </div>
        <div class="form-group row">
            <label class="col-md-2 col-form-label">Start Date</label>
            <div class="col-md-6">
                <input type="date" class="form-control" @bind="config.StartDateTime" />
            </div>
        </div>
        <div class="form-group row">
            <label class="col-md-2 col-form-label">Step size</label>
            <div class="col-md-6">
                <input type="text" class="form-control" @bind="config.StepSize">
            </div>
        </div>
        <div class="form-group row">
            <label class="col-md-2 col-form-label">Simulation duration</label>
            <div class="col-md-6">
                <input type="text" class="form-control" @bind="config.SimulationDuration">
            </div>
        </div>
        <div class="form-group row">
            <label class="col-md-2 col-form-label">Simulation Id</label>
            <div class="col-md-6">
                <input type="text" class="form-control" @bind="config.SimulationId" readonly="true">
            </div>
        </div>

        <div class="d-grid gap-2 mb-3">
            <div class="d-flex align-items-center">
                <button type="submit"
                        class="btn btn-primary"
                        style="width: 155px"
                        disabled="@isInitLoading">
                    Submit
                </button>
                @if (isInitLoading)
                {
                    <span class="spinner-border spinner-border-sm text-primary ms-2" role="status" aria-hidden="true"></span>
                }
            </div>
        </div>
        <div class="col-7">
            Response: @result
        </div>
    </EditForm>

    <h3 class="mt-4">Simulations</h3>
    @if (simulations == null)
    {
        <p><em>Loading simulations...</em></p>
    }
    else if (simulations.Count == 0)
    {
        <p><em>No simulations found.</em></p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Simulation Id</th>
                    <th>Scenario Id</th>
                    <th>Start Date</th>
                    <th>Step Size</th>
                    <th>Status</th>
                    <th>Simulation Created</th>
                    <th>Simulation Current</th>
                    <th>IP</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sim in simulations)
                {
                    <tr>
                        <td>@sim.SimulationId</td>
                        <td>@sim.ScenarioId</td>
                        <td>@sim.StartDateTime.ToShortDateString()</td>
                        <td>@sim.StepSize</td>
                        <td>@sim.Status</td>
                        <td>@sim.SimulationCreated?.ToString("g")</td>
                        <td>@sim.SimulationCurrent?.ToString("dd-MM-yyyy")</td>
                        <td>@sim.IP</td>
                        <td>
                            <a href="#" class="btn btn-link btn-sm" @onclick="() => StartSimulationFor(sim)">Start</a>
                            <a href="#" class="btn btn-link btn-sm text-danger" @onclick="() => CancelSimulationFor(sim)">Cancel</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private bool isInitLoading = false;
    private SimulationConfig? config { get; set; }
    private List<Simulation>? simulations { get; set; } = new List<Simulation>();
    private string result = "";
    CancellationTokenSource cts = new CancellationTokenSource();
    private System.Threading.Timer? _refreshTimer;

    [Inject]
    private SurimiGUIControllerService? controllerService { get; set; }

    protected override void OnInitialized()
    {
        config = new SimulationConfig();
        StartRefreshTimer();
    }

    async Task HandleInit()
    {
        if (config != null && controllerService != null)
        {
            isInitLoading = true;
            StateHasChanged();
            try
            {
                using (var activity = MyActivitySource.StartActivity("HandleInit"))
                {
                    activity?.SetTag("ScenarioId", config.ScenarioId);
                    result = "";
                    config.SimulationId = Guid.NewGuid().ToString();
                    var res = await controllerService.Init(config, cts.Token);
                    if (Guid.TryParse(res, out Guid simres))
                    {
                        config.SimulationId = res;
                        // Fetch updated simulations list after successful init
                        simulations = await controllerService.GetAllSimulations(cts.Token);
                        result = $"OK";
                    }
                    else
                    {
                        result = $"Error initializing simulation: {res}";
                    }
                }
            }
            catch (Exception ex)
            {
                result = $"Exception: {ex.Message}";
            }
            finally
            {
                isInitLoading = false;
                StateHasChanged();
            }
        }
    }


