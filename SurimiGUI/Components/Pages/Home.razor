    async Task StartSimulationFor(Simulation sim)
    {
        if (controllerService != null)
        {
            var simConfig = new SimulationConfig
            {
                ScenarioId = sim.ScenarioId,
                StartDateTime = sim.StartDateTime,
                StepSize = sim.StepSize,
                SimulationDuration = config?.SimulationDuration ?? "1 month",
                SimulationId = sim.SimulationId
            };
            try
            {
                using (var activity = MyActivitySource.StartActivity("StartSimulationFor"))
                {
                    activity?.SetTag("SimulationId", sim.SimulationId);
                    result = "";
                    result = await controllerService.RunSimulation(simConfig, CancellationToken.None);
                    // Optionally refresh simulations list
                    simulations = await controllerService.GetAllSimulations(CancellationToken.None);
                }
            }
            catch (Exception ex)
            {
                result = ex.Message;
            }
            StateHasChanged();
        }
    }

    void CancelSimulationFor(Simulation sim)
    {
        using (var activity = MyActivitySource.StartActivity("CancelSimulationFor"))
        {
            // This is a placeholder. Actual cancellation logic may require tracking tokens per simulation.
            cts.Cancel();
            result = $"Cancel requested for {sim.SimulationId}";
        }
        StateHasChanged();
    }

    private void StartRefreshTimer()
    {
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            await RefreshSimulations();
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(2));
    }

    private async Task RefreshSimulations()
    {
        if (controllerService != null)
        {
            try
            {
                var sims = await controllerService.GetAllSimulations(CancellationToken.None);
                await InvokeAsync(() =>
                {
                    simulations = sims;
                    StateHasChanged();
                });
            }
            catch
            {
                // Optionally handle errors
            }
        }
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}