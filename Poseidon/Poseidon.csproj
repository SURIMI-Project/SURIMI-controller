<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>23e3ef1c-bc1b-4802-a2fc-6f8b3116b88b</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.57.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
  </ItemGroup>

	<ItemGroup>
		<Protobuf Include="..\surimi_protocol\init_request.proto" />
		<Protobuf Include="..\surimi_protocol\species_price.proto" />
		<Protobuf Include="..\surimi_protocol\workflow.proto" GrpcServices="Server"/>
	</ItemGroup>

</Project>
