<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>3c2d240a-0ea5-42bb-9d00-7f9f62e7c3bf</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.70.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SURIMI.ServiceDefaults\SURIMI.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\surimi_protocol\init_request.proto" />
    <Protobuf Include="..\surimi_protocol\species_price.proto" />
    <Protobuf Include="..\surimi_protocol\market.proto" GrpcServices="Client" />
    <Protobuf Include="..\surimi_protocol\workflow.proto" GrpcServices="Both" />
    <Protobuf Include="..\surimi_protocol\controller.proto" GrpcServices="Server" />
  </ItemGroup>

</Project>
